       "on-hand": 20,
       "reserved": 5,
       "reorder": 15
      },
      {
       "sku": "sku-b",
       "on-hand": 5,
       "reserved": 2,
       "reorder": 10
      },
      {
       "sku": "sku-e",
       "on-hand": 50,
       "reserved": 10,
       "reorder": 20
      },
      {
       "sku": "sku-c",
       "on-hand": 3,
       "reserved": 6,
       "reorder": 2
      }
     ]
    }
   ]
  },
  {
   "capability": "purchasing.create-po",
   "input": {
    "sku": "sku-b",
    "qty": 17
   },
   "results": [
    {
