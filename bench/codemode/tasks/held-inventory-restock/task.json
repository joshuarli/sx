{
 "id": "held-inventory-restock",
 "split": "held-out",
 "kinds": [
  "conditional-call",
  "write",
  "arithmetic",
  "filter-group"
 ],
 "domain": "other",
 "sx-expressible": true,
 "description": "Restock low items. An item's available stock is `on-hand` minus `reserved` (it can be negative). For every item whose available stock is strictly below its `reorder` level, create one purchase order for (2 times `reorder`, minus the available stock) units. Items at or above the reorder level get no order. Return a list of records `sku`, `qty` (units ordered) and `po` (the purchase order id returned), sorted by `sku` ascending.",
 "types": {
  "Item": "Record {sku: String, on-hand: Int, reserved: Int, reorder: Int}"
 },
 "cores": [],
 "capabilities": [
  {
   "id": "inventory.list",
   "effect": "read",
   "input": "Record {}",
   "output": "List<Item>",
   "description": "Lists all stocked items."
  },
  {
   "id": "purchasing.create-po",
   "effect": "write",
   "idempotent": false,
   "input": "Record {sku: String, qty: Int}",
   "output": "Record {po: String}",
   "description": "Creates a purchase order and returns its id."
  }
 ],
