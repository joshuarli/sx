{
 "id": "held-billing-charges",
 "split": "held-out",
 "kinds": [
  "parallel",
  "arithmetic",
  "write",
  "partial-failure",
  "conditional-call"
 ],
 "domain": "other",
 "sx-expressible": false,
 "description": "Bill every customer for their usage. A customer's usage total in dollars is the sum of `units` times `rate` over their usage lines. Customers whose usage total is zero (no lines, or only lines with 0 units) are skipped. Every other customer is charged the usage total, raised to at least 10.00 dollars, converted to whole cents. If a charge fails, carry on with the others. Return a record with `charged`: a list of records `customer`, `cents` and `charge` (the charge id returned); `skipped`: the customers skipped for zero usage; and `failed`: a list of records `customer` and `kind` (the error kind name); every list sorted by customer name ascending.",
 "types": {
  "Usage": "Record {meter: String, units: Int, rate: Float}"
 },
 "cores": [],
 "capabilities": [
  {
   "id": "billing.customers",
   "effect": "read",
   "input": "Record {}",
   "output": "List<String>",
   "description": "Lists customer names."
  },
  {
   "id": "billing.usage",
   "effect": "read",
   "input": "Record {customer: String}",
   "output": "List<Usage>",
   "description": "Lists a customer's metered usage lines; rate is dollars per unit."
  },
  {
   "id": "billing.charge",
   "effect": "write",
   "idempotent": false,
   "input": "Record {customer: String, cents: Int}",
   "output": "Record {charge: String}",
   "description": "Charges a customer's payment method and returns the charge id."
  }
 ],
