 "domain": "other",
 "sx-expressible": true,
 "description": "Compute the total of every order, in cents. An order's subtotal is the sum of `qty` times `cents` over its lines. Its discount is `discount` percent of the subtotal, rounded down to a whole cent, and its total is the subtotal minus the discount. An order with no lines has total 0. Return a record with `orders`: a list of records `id` and `total`, sorted by total descending and then by id ascending; and `revenue`: the sum of all totals.",
 "types": {
  "Line": "Record {sku: String, qty: Int, cents: Int}",
  "Order": "Record {id: String, discount: Int, lines: List<Line>}"
 },
