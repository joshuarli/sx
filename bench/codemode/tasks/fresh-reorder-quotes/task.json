{
  "id": "fresh-reorder-quotes",
  "split": "fresh",
  "kinds": [
    "conditional-call",
    "arithmetic",
    "filter-group"
  ],
  "domain": "other",
  "sx-expressible": true,
  "description": "Plan a restock. For every SKU whose available quantity (`on-hand` minus `reserved`) is below its `reorder-point`, order `reorder-qty` units and get a quote for that quantity. Return a list of records with `sku`, `quantity` (the units ordered), and `cost` (the quote's `unit-price`, in cents, times the quantity), sorted by `sku`. Ask for quotes only for SKUs that need a restock.",
  "types": {
    "Level": "Record {sku: String, on-hand: Int, reserved: Int, reorder-point: Int, reorder-qty: Int}",
    "Quote": "Record {sku: String, unit-price: Int}"
  },
  "cores": [],
  "capabilities": [
    {
      "id": "stock.levels",
      "effect": "read",
      "input": "Record {}",
      "output": "List<Level>",
      "description": "Lists every SKU with its on-hand and reserved units and its reorder rule."
    },
    {
      "id": "suppliers.quote",
      "effect": "read",
      "input": "Record {sku: String, quantity: Int}",
      "output": "Quote",
      "description": "Quotes the price in cents per unit for buying a quantity of a SKU."
    }
  ],
  "responses": [
    {
