              "on-hand": 50,
              "reserved": 10,
              "reorder-point": 50,
              "reorder-qty": 100
            },
            {
              "sku": "nut",
              "on-hand": 30,
              "reserved": 0,
              "reorder-point": 20,
              "reorder-qty": 80
            },
            {
              "sku": "anchor",
              "on-hand": 20,
              "reserved": 20,
              "reorder-point": 1,
              "reorder-qty": 25
            },
            {
              "sku": "clip",
              "on-hand": 5,
              "reserved": 0,
