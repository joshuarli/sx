  "filter-group"
 ],
 "domain": "other",
 "sx-expressible": true,
 "description": "Every open ticket with priority `P1` and no assignee must be assigned to the person currently on call for its team. Assign them. If the on-call lookup for a team fails with any error, leave that team's tickets alone. Tickets with another priority, or that already have an assignee, are not touched. Return a record with `assigned`: a list of records `ticket` and `user`, ascending by ticket id; and `unassigned`: the ids of P1 tickets without an assignee that could not be assigned, ascending.",
 "types": {
  "Ticket": "Record {id: Int, team: String, priority: String, assignee: Option<String>}"
 },
 "cores": [],
 "capabilities": [
  {
   "id": "tickets.list-open",
   "effect": "read",
   "input": "Record {}",
   "output": "List<Ticket>",
   "description": "Lists all open tickets."
  },
  {
   "id": "oncall.current",
   "effect": "read",
   "input": "Record {team: String}",
   "output": "Record {user: String}",
   "description": "Returns who is currently on call for a team."
  },
  {
   "id": "tickets.assign",
   "effect": "write",
   "idempotent": true,
   "input": "Record {id: Int, user: String}",
   "output": "Unit",
   "description": "Sets a ticket's assignee."
  }
 ],
