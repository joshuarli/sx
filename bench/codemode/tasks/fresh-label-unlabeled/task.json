  "domain": "repomod",
  "sx-expressible": true,
  "description": "Add the label `needs-triage` to every open issue of `acme/web` that has no labels, in the order the issues are listed. Do not retry. Return a record with `labeled` (the ids of issues that were labeled) and `failed` (records with `id` and `kind`, the name of the error kind, for issues where adding the label failed), each in listed order.",
  "types": {
    "Issue": "Record {id: Int, title: String, labels: List<String>}"
  },
  "cores": [],
  "capabilities": [
    {
      "id": "issues.open",
      "effect": "read",
      "input": "Record {repo: String}",
      "output": "List<Issue>",
      "description": "Lists the open issues of a repository with their labels."
    },
    {
      "id": "issues.add-label",
      "effect": "write",
      "idempotent": true,
      "input": "Record {repo: String, id: Int, label: String}",
      "output": "Unit",
      "description": "Adds a label to an issue; adding a label it already has changes nothing."
    }
  ],
