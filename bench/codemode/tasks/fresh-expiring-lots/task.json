  "domain": "other",
  "sx-expressible": true,
  "description": "Group the lots that expire soon by warehouse. A lot expires soon when its `days-left` is 14 or fewer (a negative value means already expired) and its `quantity` is above 0. Return a map from warehouse to the lot ids in it, ordered by `days-left` lowest first and then by lot id. Leave out warehouses with no such lots.",
  "types": {
    "Lot": "Record {lot: String, warehouse: String, days-left: Int, quantity: Int}"
  },
  "cores": [],
  "capabilities": [
    {
      "id": "batches.list",
      "effect": "read",
      "input": "Record {}",
      "output": "List<Lot>",
      "description": "Lists every stocked lot with its warehouse, days until expiry, and units on hand."
    }
  ],
