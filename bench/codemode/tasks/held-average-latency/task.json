 "domain": "other",
 "sx-expressible": false,
 "description": "For every service, compute the mean of its latency samples in milliseconds, rounded to 2 decimal places. Return a record with `means`: a list of records `service` and `mean` (null for a service with no samples), sorted by service name ascending; and `slowest`: the name of the service with the highest mean, taking the alphabetically first name on a tie, or null if no service has samples.",
 "cores": [],
 "capabilities": [
  {
   "id": "metrics.services",
   "effect": "read",
   "input": "Record {}",
   "output": "List<String>",
   "description": "Lists the names of monitored services."
  },
  {
   "id": "metrics.latency",
   "effect": "read",
   "input": "Record {service: String}",
   "output": "List<Float>",
   "description": "Returns recent latency samples in milliseconds for a service."
  }
 ],
