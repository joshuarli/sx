      "message": "t"
     }
    },
    {
     "error": {
      "kind": "Timeout",
      "message": "t"
     }
    },
    {
     "output": {
      "items": [
       {
        "name": "ky",
        "downloads": 400
       },
       {
        "name": "undici",
        "downloads": 1200
       }
      ],
      "next": "p3"
     }
    }
   ]
  },
  {
   "capability": "registry.search",
   "input": {
    "query": "http",
    "after": "p3"
   },
   "results": [
    {
     "output": {
      "items": [
       {
