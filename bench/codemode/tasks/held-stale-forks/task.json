{
 "id": "held-stale-forks",
 "split": "held-out",
 "kinds": [
  "parallel",
  "filter-group",
  "schema-detail"
 ],
 "domain": "repomod",
 "sx-expressible": true,
 "description": "Among all catalogued repositories, find the forks whose last push was before 2025-01-01 (pushed-at is an ISO date `YYYY-MM-DD`; a push on 2025-01-01 is not before it). Return a list of records with `repo` (the repository id) and `upstream` (the id of the repository it was forked from, or null when that is not known), sorted by `repo` ascending.",
 "types": {
  "Repo": "Record {id: String, owner: String, name: String, tags: List<String>, archived: Bool}",
  "Meta": "Record {id: String, fork: Bool, parent: Option<String>, pushed-at: String, stars: Int}"
 },
 "cores": [],
 "capabilities": [
  {
   "id": "catalog.list",
   "effect": "read",
   "input": "Record {tags: List<String>}",
   "output": "List<Repo>",
   "description": "Lists catalogued repositories that carry every given tag. An empty list of tags lists all repositories."
  },
  {
   "id": "github.get-repo",
   "effect": "read",
   "input": "Record {id: String}",
   "output": "Meta",
   "description": "Returns GitHub metadata for a repository id."
  }
 ],
 "responses": [
  {
   "capability": "catalog.list",
   "input": {
    "tags": []
   },
   "results": [
    {
     "output": [
      {
       "id": "c/six",
       "owner": "c",
       "name": "six",
       "tags": [],
       "archived": false
      },
      {
       "id": "a/one",
       "owner": "a",
       "name": "one",
       "tags": [],
       "archived": false
      },
      {
       "id": "b/three",
       "owner": "b",
       "name": "three",
       "tags": [],
       "archived": false
      },
      {
       "id": "a/two",
       "owner": "a",
       "name": "two",
       "tags": [],
       "archived": false
      },
      {
       "id": "c/five",
       "owner": "c",
       "name": "five",
       "tags": [],
       "archived": false
      },
      {
       "id": "b/four",
       "owner": "b",
       "name": "four",
       "tags": [],
       "archived": false
      }
     ]
    }
   ]
  },
  {
   "capability": "github.get-repo",
   "input": {
    "id": "a/one"
