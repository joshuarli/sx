{
  "fs.list": {"roots": ["{{root}}"]},
  "fs.stat": {"roots": ["{{root}}"]},
  "fs.read-text": {"roots": ["{{root}}"]},
  "fs.write-text": {"roots": ["{{root}}/archive"]},
  "process.run": {
    "commands": [
