{
  "description": "A failed par branch fails the par with the lowest failed branch.",
  "program": "(match (attempt (par (call store.get {:id \"a\"}) (call store.get {:id \"b\"}) (call store.get {:id \"c\"}))) (ok t) \"ok\" (err e) (get e :message))",
