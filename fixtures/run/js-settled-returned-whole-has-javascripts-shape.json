{
  "description": "A Settled that the program returns is written as {status, value} or {status, reason}, in a list as well.",
  "python": false,
  "dialect": "js",
  "program": "[(attempt \"a\") (attempt (fail \"boom\"))]",
  "declarations": "declarations/js.json",
  "allow": [
    "store.list",
    "store.size",
    "store.read",
    "store.maybe",
    "store.point",
    "store.reading",
    "store.sizes",
    "store.put",
    "store.average"
  ],
  "expect": {
    "completed": [{"status": "fulfilled", "value": "a"}, {"status": "rejected", "reason": {"kind": "Failed", "message": "boom"}}]
  }
}
