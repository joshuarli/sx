  "python": false,
  "program": "(let [item (call store.get {:id \"a\"})] [(get item :size 0) (get item :id \"\") (get item :size (+ 1 2))])",
  "declarations": "declarations.json",
  "allow": [
    "store.get"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {"id": "a"},
      "results": [{"output": {"id": "a", "size": 7}}]
    }
  ],
  "expect": {
