{
  "description": "replace with a string pattern replaces the first occurrence only.",
  "python": false,
  "dialect": "js",
  "program": "[(js.replace-first \"a-b-c\" \"-\" \"+\") (js.replace-first \"abc\" \"z\" \"y\")]",
  "declarations": "declarations/js.json",
  "allow": [
    "store.list",
    "store.size",
    "store.read",
    "store.maybe",
    "store.point",
    "store.reading",
    "store.sizes",
    "store.put",
    "store.average"
  ],
  "expect": {
    "completed": [
      "a+b-c",
      "abc"
    ]
  }
}
