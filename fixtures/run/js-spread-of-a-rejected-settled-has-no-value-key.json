{
  "description": "A rejected Settled spreads status and reason, with no value key, as JavaScript does.",
  "python": false,
  "dialect": "js",
  "program": "(js.stringify (record-spread (:field \"i\" 0) (:spread (attempt (fail \"boom\")))))",
  "declarations": "declarations/js.json",
  "allow": [
    "store.list",
    "store.size",
    "store.read",
    "store.maybe",
    "store.point",
    "store.reading",
    "store.sizes",
    "store.put",
    "store.average"
  ],
  "expect": {
    "completed": "{\"i\":0,\"status\":\"rejected\",\"reason\":{\"kind\":\"Failed\",\"message\":\"boom\"}}"
  }
}
