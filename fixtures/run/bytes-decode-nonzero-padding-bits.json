{
  "description": "Base64 whose padding bits are not zero is an invalid host response.",
  "program": "(call blob.get {:name \"a\"})",
  "declarations": "declarations.json",
  "allow": [
    "blob.get"
  ],
  "responses": [
    {
      "capability": "blob.get",
      "input": {
        "name": "a"
      },
      "results": [
        {
          "output": "aGVsbG9="
        }
      ]
    }
  ],
  "expect": {
    "failed": "invalid-host-response"
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "blob.get",
      "input": {
        "name": "a"
      }
    },
    {
      "response": "r:1",
      "output": "aGVsbG9="
    }
  ]
}
