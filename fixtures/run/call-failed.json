{
  "description": "An unhandled call error ends the program.",
  "program": "(call store.get {:id \"a\"})",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "error": {
            "kind": "NotFound",
            "message": "gone"
          }
        }
      ]
    }
  ],
  "expect": {
    "failed": "call-failed"
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "error": {
        "kind": "NotFound",
        "message": "gone"
      }
    }
  ]
}
