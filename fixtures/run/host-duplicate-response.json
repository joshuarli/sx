{
  "description": "Answering a request twice is an invalid host response.",
  "program": "(call store.get {:id \"a\"})",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "steps": [
    {
      "requests": [
        "r:1"
      ],
      "respond": [
        [
          "r:1",
          {
            "output": {
              "id": "a",
              "size": 1
            }
          }
        ],
        [
          "r:1",
          {
            "output": {
              "id": "a",
              "size": 1
            }
          }
        ]
      ]
    }
  ],
  "expect": {
    "failed": "invalid-host-response"
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    }
  ]
}
