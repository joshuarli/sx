{
  "description": "retry with :on retries only the listed kinds.",
  "program": "(get (retry {:delays [10ms] :on [NotFound]} (call store.get {:id \"a\"})) :size)",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "error": {
            "kind": "NotFound",
            "message": "not yet"
          }
        },
        {
          "output": {
            "id": "a",
            "size": 3
          }
        }
      ]
    }
  ],
  "expect": {
    "completed": 3
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "error": {
        "kind": "NotFound",
        "message": "not yet"
      }
    },
    {
      "delay": "r:2",
      "milliseconds": 10
    },
    {
      "response": "r:2",
      "output": null
    },
    {
      "request": "r:3",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:3",
      "output": {
        "id": "a",
        "size": 3
      }
    }
  ]
}
