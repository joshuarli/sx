{
  "description": "any? stops at the first element that decides it.",
  "program": "(any? (fn [i] (= (get (call store.get {:id i}) :size) 1)) [\"a\" \"b\"])",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "output": {
            "id": "a",
            "size": 1
          }
        }
      ]
    }
  ],
  "expect": {
    "completed": true
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "output": {
        "id": "a",
        "size": 1
      }
    }
  ]
}
