{
  "description": "A delay is a request the host answers with null, between retry attempts.",
  "program": "(retry {:delays [250ms]} (call store.get {:id \"a\"}))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "steps": [
    {
      "requests": [
        "r:1"
      ],
      "respond": [
        [
          "r:1",
          {
            "error": {
              "kind": "Unavailable",
              "message": "x"
            }
          }
        ]
      ]
    },
    {
      "requests": [
        "r:2"
      ],
      "respond": [
        [
          "r:2",
          {
            "output": null
          }
        ]
      ]
    },
    {
      "requests": [
        "r:3"
      ],
      "respond": [
        [
          "r:3",
          {
            "output": {
              "id": "a",
              "size": 1
            }
          }
        ]
      ]
    }
  ],
  "expect": {
    "completed": {
      "id": "a",
      "size": 1
    }
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "error": {
        "kind": "Unavailable",
        "message": "x"
      }
    },
    {
      "delay": "r:2",
      "milliseconds": 250
    },
    {
      "response": "r:2",
      "output": null
    },
    {
      "request": "r:3",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:3",
      "output": {
        "id": "a",
        "size": 1
      }
    }
  ]
}
