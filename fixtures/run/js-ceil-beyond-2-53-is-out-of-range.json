  "python": false,
  "dialect": "js",
  "program": "(ceil 1e17)",
  "declarations": "declarations/js.json",
  "allow": [
    "store.list",
    "store.size",
    "store.read",
    "store.maybe",
    "store.point",
    "store.reading",
    "store.sizes",
    "store.put",
    "store.average"
  ],
  "expect": {
    "failed": "out-of-range"
  }
}
