{
  "description": "An Int inside a record payload of an enum a tool returns is checked.",
  "python": false,
  "dialect": "js",
  "program": "(call store.reading {})",
  "declarations": "declarations/js-payloads.json",
  "allow": [
    "store.sizes",
    "store.size",
    "store.reading",
    "store.listed",
    "store.outcome"
