{
  "description": "A call error must use a kernel error kind.",
  "program": "(attempt (call store.get {:id \"a\"}))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "error": {
            "kind": "Teapot",
            "message": "no"
          }
        }
      ]
    }
  ],
  "expect": {
    "failed": "invalid-host-response"
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "error": {
        "kind": "Teapot",
        "message": "no"
      }
    }
  ]
}
