{
  "description": "get with a none default keeps the field optional.",
  "program": "(map (fn [r] {:name (get r :name) :note (get r :note none)}) (call rows.list {}))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state",
    "rows.list",
    "rows.add",
    "checks.list"
  ],
  "responses": [
    {
      "capability": "rows.list",
      "input": {},
      "results": [
        {
          "output": [
            {
              "name": "a",
              "note": "fast",
              "hits": 3
            },
            {
              "name": "b",
              "note": null,
              "hits": null
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "completed": [
      {
        "name": "a",
        "note": "fast"
      },
      {
        "name": "b",
        "note": null
      }
    ]
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "rows.list",
      "input": {}
    },
    {
      "response": "r:1",
      "output": [
        {
          "name": "a",
          "note": "fast",
          "hits": 3
        },
        {
          "name": "b",
          "note": null,
          "hits": null
        }
      ]
    }
  ]
}
