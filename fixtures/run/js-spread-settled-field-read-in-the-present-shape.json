{
  "description": "A field every shape has is an ordinary read, and one only this shape has reads too.",
  "python": false,
  "dialect": "js",
  "program": "(let [r (record-spread (:field \"i\" 1) (:spread (attempt 3)))] [(get r :i) (get r :status)])",
