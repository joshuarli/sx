{
  "description": "Logs from the branches of par-map come in the order of the machine's fibers, which is the list order.",
  "python": false,
  "program": "(par-map {:limit 3} (fn [x] (let [_ (log \"item\" x)] (* x x))) [1 2 3])",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state",
    "rows.list"
  ],
  "expect": {
    "completed": [
      1,
      4,
      9
    ]
  },
  "logs": [
    "item 1",
    "item 2",
    "item 3"
  ]
}
