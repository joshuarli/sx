{
  "description": "par returns results in source order when the host answers in reverse order.",
  "program": "(par (call store.get {:id \"a\"}) (call store.get {:id \"b\"}))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "steps": [
    {
      "requests": [
        "r.0:1",
        "r.1:1"
      ],
      "respond": [
        [
          "r.1:1",
          {
            "output": {
              "id": "b",
              "size": 2
            }
          }
        ],
        [
          "r.0:1",
          {
            "output": {
              "id": "a",
              "size": 1
            }
          }
        ]
      ]
    }
  ],
  "expect": {
    "completed": [
      {
        "id": "a",
        "size": 1
      },
      {
        "id": "b",
        "size": 2
      }
    ]
  },
  "trace": [
    {
      "request": "r.0:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "request": "r.1:1",
      "capability": "store.get",
      "input": {
        "id": "b"
      }
    },
    {
      "response": "r.0:1",
      "output": {
        "id": "a",
        "size": 1
      }
    },
    {
      "response": "r.1:1",
      "output": {
        "id": "b",
        "size": 2
      }
    }
  ]
}
