{
  "description": "retry waits each listed delay while the failure is transient.",
  "program": "(get (retry {:delays [1s 2s 4s]} (call store.get {:id \"a\"})) :size)",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "error": {
            "kind": "Unavailable",
            "message": "502"
          }
        },
        {
          "error": {
            "kind": "Timeout",
            "message": "slow"
          }
        },
        {
          "output": {
            "id": "a",
            "size": 7
          }
        }
      ]
    }
  ],
  "expect": {
    "completed": 7
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "error": {
        "kind": "Unavailable",
        "message": "502"
      }
    },
    {
      "delay": "r:2",
      "milliseconds": 1000
    },
    {
      "response": "r:2",
      "output": null
    },
    {
      "request": "r:3",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:3",
      "error": {
        "kind": "Timeout",
        "message": "slow"
      }
    },
    {
      "delay": "r:4",
      "milliseconds": 2000
    },
    {
      "response": "r:4",
      "output": null
    },
    {
      "request": "r:5",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:5",
      "output": {
        "id": "a",
        "size": 7
      }
    }
  ]
}
