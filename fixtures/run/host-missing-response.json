{
  "description": "Leaving a request unanswered is an invalid host response.",
  "program": "(par (call store.get {:id \"a\"}) (call store.get {:id \"b\"}))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "steps": [
    {
      "requests": [
        "r.0:1",
        "r.1:1"
      ],
      "respond": [
        [
          "r.0:1",
          {
            "output": {
              "id": "a",
              "size": 1
            }
          }
        ]
      ]
    }
  ],
  "expect": {
    "failed": "invalid-host-response"
  },
  "trace": [
    {
      "request": "r.0:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "request": "r.1:1",
      "capability": "store.get",
      "input": {
        "id": "b"
      }
    }
  ]
}
