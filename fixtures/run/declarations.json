{
  "types": {
    "Item": "Record {id: String, size: Int}",
    "Row": "Record {name: String, note: Option<String>, hits: Option<Int>}",
    "Check": "Record {name: String, level: Level}",
    "Order": "Record {customer: String, total: Int}"
  },
  "enums": {"Level": {"Passing": null, "Failing": null, "Unknown": null}},
  "capabilities": [
    {"id": "store.get", "effect": "read", "input": "Record {id: String}", "output": "Item", "description": "Reads one item."},
    {"id": "store.list", "effect": "read", "input": "Record {}", "output": "List<String>", "description": "Lists item ids."},
    {"id": "store.put", "effect": "write", "idempotent": true, "input": "Record {id: String, size: Int}", "output": "Unit", "description": "Stores an item."},
    {"id": "mail.send", "effect": "write", "idempotent": false, "input": "Record {to: String}", "output": "Unit", "description": "Sends one email."},
    {"id": "rows.list", "effect": "read", "input": "Record {}", "output": "List<Row>", "description": "Lists rows."},
    {"id": "rows.add", "effect": "write", "idempotent": true, "input": "Row", "output": "Unit", "description": "Stores a row."},
    {"id": "checks.list", "effect": "read", "input": "Record {}", "output": "List<Check>", "description": "Lists checks."},
    {"id": "checks.add", "effect": "write", "idempotent": true, "input": "Check", "output": "Unit", "description": "Stores a check."},
    {"id": "orders.list", "effect": "read", "input": "Record {}", "output": "List<Order>", "description": "Lists orders."},
    {"id": "totals.get", "effect": "read", "input": "Record {}", "output": "Map<String, Int>", "description": "Reads counts keyed by name."},
    {"id": "totals.put", "effect": "write", "idempotent": true, "input": "Record {totals: Map<String, Int>}", "output": "Unit", "description": "Stores counts keyed by name."},
    {"id": "job.state", "effect": "read", "input": "Record {id: String}", "output": "String", "description": "Reads a job's state."}
  ]
}
