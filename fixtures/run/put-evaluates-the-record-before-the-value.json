{
  "description": "put evaluates its record argument, then its value, so the calls happen in that order.",
  "python": false,
  "program": "(put (call store.get {:id \"a\"}) \"size\" (get (call store.get {:id \"b\"}) :size))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state",
    "rows.list"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "output": {
            "id": "a",
            "size": 7
          }
        }
      ]
    },
    {
      "capability": "store.get",
      "input": {
        "id": "b"
      },
      "results": [
        {
          "output": {
            "id": "b",
            "size": 9
          }
        }
      ]
    }
  ],
  "expect": {
    "completed": {
      "id": "a",
      "size": 9
    }
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "output": {
        "id": "a",
        "size": 7
      }
    },
    {
      "request": "r:2",
      "capability": "store.get",
      "input": {
        "id": "b"
      }
    },
    {
      "response": "r:2",
      "output": {
        "id": "b",
        "size": 9
      }
    }
  ]
}
