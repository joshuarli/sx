{
  "description": "A cond evaluates the tests in order and stops at the first true one.",
  "program": "(cond (= (count (call store.list {})) 1) (get (call store.get {:id \"a\"}) :size) (= (count (call store.list {})) 2) 0 :else -1)",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state",
    "rows.list",
    "rows.add",
    "checks.list",
    "checks.add"
  ],
  "responses": [
    {
      "capability": "store.list",
      "input": {},
      "results": [
        {
          "output": [
            "a"
          ]
        }
      ]
    },
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "output": {
            "id": "a",
            "size": 7
          }
        }
      ]
    }
  ],
  "expect": {
    "completed": 7
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.list",
      "input": {}
    },
    {
      "response": "r:1",
      "output": [
        "a"
      ]
    },
    {
      "request": "r:2",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:2",
      "output": {
        "id": "a",
        "size": 7
      }
    }
  ]
}
