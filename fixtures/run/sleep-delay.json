{
  "description": "sleep issues one delay request of its duration and the program continues after the host answers.",
  "program": "(let [_ (sleep 10s) item (call store.get {:id \"a\"})] (get item :size))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "output": {
            "id": "a",
            "size": 3
          }
        }
      ]
    }
  ],
  "expect": {
    "completed": 3
  },
  "trace": [
    {
      "delay": "r:1",
      "milliseconds": 10000
    },
    {
      "response": "r:1",
      "output": null
    },
    {
      "request": "r:2",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:2",
      "output": {
        "id": "a",
        "size": 3
      }
    }
  ]
}
