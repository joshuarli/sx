{
  "description": "sleep returns Unit, which encodes as null.",
  "program": "(sleep 1s)",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [],
  "expect": {
    "completed": null
  },
  "trace": [
    {
      "delay": "r:1",
      "milliseconds": 1000
    },
    {
      "response": "r:1",
      "output": null
    }
  ]
}
