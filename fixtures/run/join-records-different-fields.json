{
  "description": "Branches that return records with different fields join to the union of the fields, and a field only one branch writes is optional, none in the other branch.",
  "program": "(let [rs (map (fn [r] (if (= (get r :name) \"a\") {:id \"a\" :ok true} {:id \"b\" :ok false :kind \"x\"})) (call rows.list {}))] [rs (map (fn [r] (get r :kind \"-\")) rs)])",
