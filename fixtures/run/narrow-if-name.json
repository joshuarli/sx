{
  "description": "An if on an optional name tests presence, and the then-branch sees the unwrapped value.",
  "program": "(map (fn [r] (let [note (get r :note)] (if note (str (get r :name) \": \" note) (get r :name)))) (call rows.list {}))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state",
    "rows.list",
    "rows.add",
    "checks.list"
  ],
  "responses": [
    {
      "capability": "rows.list",
      "input": {},
      "results": [
        {
          "output": [
            {
              "name": "a",
              "note": "fast",
              "hits": 3
            },
            {
              "name": "b",
              "note": null,
              "hits": null
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "completed": [
      "a: fast",
      "b"
    ]
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "rows.list",
      "input": {}
    },
    {
      "response": "r:1",
      "output": [
        {
          "name": "a",
          "note": "fast",
          "hits": 3
        },
        {
          "name": "b",
          "note": null,
          "hits": null
        }
      ]
    }
  ]
}
