{
  "description": "attempt turns a call error into an err value.",
  "program": "(match (attempt (call store.get {:id \"a\"})) (ok i) \"found\" (err e) (get e :message))",
  "declarations": "declarations.json",
  "allow": [
    "store.get",
    "store.list",
    "store.put",
    "mail.send",
    "job.state"
  ],
  "responses": [
    {
      "capability": "store.get",
      "input": {
        "id": "a"
      },
      "results": [
        {
          "error": {
            "kind": "NotFound",
            "message": "gone"
          }
        }
      ]
    }
  ],
  "expect": {
    "completed": "gone"
  },
  "trace": [
    {
      "request": "r:1",
      "capability": "store.get",
      "input": {
        "id": "a"
      }
    },
    {
      "response": "r:1",
      "error": {
        "kind": "NotFound",
        "message": "gone"
      }
    }
  ]
}
