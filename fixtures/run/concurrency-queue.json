{
  "description": "Requests beyond the concurrency budget wait for the next suspension, lowest IDs first.",
  "program": "(par (call store.get {:id \"0\"}) (call store.get {:id \"1\"}) (call store.get {:id \"2\"}) (call store.get {:id \"3\"}) (call store.get {:id \"4\"}))",
