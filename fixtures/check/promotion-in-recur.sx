; task: dev-events-pages
(loop {:max 20} [cursor none
                 errors []]
  (let [page (call audit.page {:cursor cursor})
        page-errors (map (fn [e] (get e :id))
                         (filter (fn [e] (= (get e :kind) "error"))
                                 (get page :events)))
        all-errors (concat errors page-errors)]
    (match (get page :next)
      (some next-cursor) (recur next-cursor all-errors)
      none all-errors)))
