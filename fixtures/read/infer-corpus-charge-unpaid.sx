; python: no
; closers: infer
(let [invoices (call billing.unpaid {})]
  (loop {:max 10000} [idx 0 paid [] failed []]
    (if (= idx (count invoices))
      {:paid paid :failed failed}
      (let [inv (nth invoices idx)
            iid (get inv :id)
            amt (get inv :amount)
            k (str "charge-" iid)
            res (attempt (retry {:delays [2s 4s 8s] :on [Timeout Unavailable]} (call payments.charge {:invoice iid :amount amt :key k})))]
        (match res
          (ok _) (recur (+ idx 1) (concat paid [iid]) failed)
          (err e) (match (get e :kind)
                    Conflict (recur (+ idx 1) (concat paid [iid]) failed)
                    _ (recur (+ idx 1) paid (concat failed [{:id iid :kind (str (get e :kind))}])))))))))
