{
  "enums": {
    "mcp-demo.EnumsInputMode": {
      "fast": null,
      "slow-lane": null
    },
    "mcp-demo.EnumsInputKind": {
      "a": null,
      "b": null
    },
    "mcp-demo.EnumsOutputStatus": {
      "open": null,
      "closed": null
    }
  },
  "capabilities": [
    {
      "id": "mcp-demo.scalars",
      "effect": "read",
      "description": "Reads scalar values.",
      "input": "Record {name: String, count: Int, ratio: Option<Float>, flag: Option<Bool>}",
      "output": "Record open {ok: Bool, score: Option<Float>}",
      "mcp": {
        "server": "demo",
        "tool": "scalars",
        "result": "structured"
      }
    },
    {
      "id": "mcp-demo.enums",
      "effect": "read",
      "description": "Enumerations",
      "input": "Record {mode: mcp-demo.EnumsInputMode, kind: Option<mcp-demo.EnumsInputKind>}",
      "output": "Record {status: mcp-demo.EnumsOutputStatus}",
      "mcp": {
        "server": "demo",
        "tool": "enums",
        "result": "structured"
      }
    },
    {
      "id": "mcp-demo.collections",
      "effect": "read",
      "description": "Lists, nested lists, and a tuple.",
      "input": "Record {tags: List<String>, matrix: Option<List<List<Int>>>, point: Option<Tuple<Float, Float>>}",
      "output": "Record open {rows: List<Record open {id: Int, label: Option<String>}>}",
      "mcp": {
        "server": "demo",
        "tool": "collections",
        "result": "structured"
      }
    },
    {
      "id": "mcp-demo.nullable-forms",
      "effect": "read",
      "description": "Optional and nullable properties.",
      "input": "Record {a: Option<String>, b: Option<Int>, c: String}",
      "output": "Record open {d: Option<String>, e: Option<Int>, f: Option<String>}",
      "mcp": {
        "server": "demo",
        "tool": "nullable_forms",
        "result": "structured"
      }
    },
    {
      "id": "mcp-demo.refs",
      "effect": "read",
      "description": "Local references.",
