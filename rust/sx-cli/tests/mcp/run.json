              {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "integer"
                  }
                },
                "required": [
                  "ok"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "err": {
                    "type": "string"
                  }
                },
                "required": [
                  "err"
                ],
                "additionalProperties": false
              }
            ]
          },
          "fail": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "integer"
                  }
                },
                "required": [
                  "ok"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "err": {
                    "type": "string"
                  }
                },
                "required": [
                  "err"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
