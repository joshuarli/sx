{
  "cores": [
    "text",
    "yaml",
    "decimal",
    "semver",
    "re"
  ],
  "packs": [
    "fs",
    "process"
  ],
  "capabilities": [
    {
      "id": "ci.checks",
      "http": {
        "method": "GET",
        "url": "http://ci.test/repos/{repo}/commits/{sha}/checks",
        "query": []
      },
      "input": "Record {repo: String, sha: String}",
      "output": "Record open {state: String}",
      "effect": "read",
      "description": "Returns the CI state of one commit."
    },
    {
      "id": "shop.item",
      "http": {
        "method": "GET",
        "url": "http://shop.test/items/{sku}",
        "query": []
      },
      "input": "Record {sku: String}",
      "output": "Record open {name: String}",
      "effect": "read",
      "description": "Reads one item."
    },
    {
      "id": "store.save-order",
      "sqlite": {
        "database": "/srv/store.db",
        "statement": "INSERT INTO orders(id, cents) VALUES (:id, :cents)"
      },
      "input": "Record {id: String, cents: Int}",
      "output": "Int",
      "effect": "write",
      "idempotent": false,
      "description": "Saves one order."
    },
    {
      "id": "store.orders-over",
      "sqlite": {
        "database": "/srv/store.db",
        "statement": "SELECT id FROM orders WHERE cents > :cents"
      },
      "input": "Record {cents: Int}",
      "output": "List<Record {id: String}>",
      "effect": "read",
      "description": "Lists the orders over an amount."
    },
    {
      "id": "mcp-shop.lookup-item",
      "input": "Record {sku: String}",
      "output": "Record open {sku: String}",
      "effect": "read",
      "description": "Looks up one item."
    },
    {
      "id": "people.list",
      "effect": "read",
      "input": "Record {team: String}",
      "output": "List<User>",
      "description": "Lists the people on a team."
    },
    {
      "id": "metrics.uptime",
      "effect": "read",
      "input": "Record {host: String}",
      "output": "Record {seconds: Int}",
      "description": "Reads a host's uptime."
    },
    {
      "id": "storage.files",
      "effect": "read",
      "input": "Record {page: Int}",
      "output": "Record {files: List<File>, last: Bool}",
      "description": "Reads one page of files."
    }
  ],
  "types": {
    "User": "Record {name: String, active: Bool}",
    "File": "Record {bytes: Int}"
  }
}
