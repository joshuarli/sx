(let [readOrDefault (fn [path]
                      (let [ret'1 (match (attempt (some (call fs.read-text {:path path})))
                                    (ok v'2)
                                    v'2
                                    (err e)
                                    (if (= (get e :kind) "NotFound") (some "") (fail e)))]
                        (match ret'1 (some r'3) r'3 none (fail "unreachable"))))]
  (let [[a b] (par (readOrDefault "a") (readOrDefault "b"))] (+ a b)))
