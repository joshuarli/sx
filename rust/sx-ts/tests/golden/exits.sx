(let [files (call fs.list {:path "."})
      found ""
      [_ ret'2 found] (reduce (fn [[done'1 ret'2 found] f]
                                (if done'1
                                  [done'1 ret'2 found]
                                  (if (= (get f :size) 0)
                                    [false none found]
                                    (if (= (get f :name) "stop")
                                      [true none found]
                                      (if (> (get f :size) 1000)
                                        [true (some (get f :name)) found]
                                        (let [found (get f :name)] [false none found]))))))
                        [false none found]
                        files)]
  (match ret'2 (some r'3) r'3 none found))
