(let [files (call fs.list {:path "."})
      [_ ret'2] (reduce (fn [[done'1 ret'2] f]
                          (if done'1
                            [done'1 ret'2]
                            (let [[_ ret'4] (reduce (fn [[done'3 ret'4] g]
                                                      (if done'3
                                                        [done'3 ret'4]
                                                        (if (> (get g :size) (get f :size))
                                                          [false none]
                                                          (if (= (get g :name) "stop")
                                                            [true (some (get g :name))]
                                                            [false none]))))
                                              [false none]
                                              files)]
                              (match ret'4 (some r'5) [true (some r'5)] none [false none]))))
                  [false none]
                  files)]
  (match ret'2
    (some r'7)
    r'7
    none
    (match (attempt (let [_ (reduce (fn [done'6 f]
                                      (if done'6
                                        done'6
                                        (if (< (get f :size) 0)
                                          true
                                          (let [_ (call fs.read-text {:path (get f :name)})] false))))
                              false
                              files)]
                      unit))
      (ok _)
      none
      (err e)
      (str "CallError: " (get e :message)))))
